{
  "name": "x402-demo",
  "version": "1.0.0",
  "description": "SBC x402 Facilitator Demo - Multi-chain payment infrastructure for AI agents",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "install-all": "npm install && npm run install:facilitator && npm run install:api && npm run install:agent",
    "install:facilitator": "cd packages/facilitator && npm install",
    "install:api": "cd packages/premium-api && npm install",
    "install:agent": "cd packages/ai-agent && npm install",
    "dev:facilitator": "cd packages/facilitator && npm run dev",
    "dev:api": "cd packages/premium-api && npm run dev",
    "run:agent": "cd packages/ai-agent && npm run start",
    "approve-base-facilitator": "cd packages/ai-agent && npm run approve-base-facilitator",
    "approve-base-sepolia-facilitator": "cd packages/ai-agent && npm run approve-base-sepolia-facilitator",
    "approve-solana-facilitator": "cd packages/ai-agent && npm run approve-solana-facilitator",
    "test": "cd packages/facilitator && npm test",
    "test:watch": "cd packages/facilitator && npm run test:watch",
    "test:coverage": "cd packages/facilitator && npm run test:coverage"
  },
  "keywords": [
    "x402",
    "facilitator",
    "base",
    "solana",
    "payments",
    "ai-agents"
  ],
  "author": "SBC",
  "license": "MIT"
}